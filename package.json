{
  "name": "sportigon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:tsc": "tsc -w -p tsconfig.server.json",
    "dev:node": "nodemon --watch dist --exec \"node -r tsconfig-paths/register dist/server.js\"",
    "dev": "concurrently \"yarn dev:tsc\" \"yarn dev:node\"",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build": "next build && yarn build:server",
    "start": "cross-env NODE_ENV=production node -r tsconfig-paths/register dist/server.js"
  },
  "_moduleAliases": {
    "@": "dist/src",
    "@models": "dist/src/models",
    "@libs": "dist/src/libs",
    "@config": "dist/src/config"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.7.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/validator": "^13.15.2",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.1",
    "mongoose": "^8.11.0",
    "next": "15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.0",
    "nodemon": "^3.1.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
